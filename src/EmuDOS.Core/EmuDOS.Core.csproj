<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Zero-copy spans over native libretro video/audio buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The curated catalog baseline (hashed names only; built from a local source list with
         the EmuDOS build-catalog command). Installed on first run; a newer release asset replaces it. -->
    <EmbeddedResource Include="Catalog\catalog.db" LogicalName="EmuDOS.Catalog.baseline.db" />
  </ItemGroup>

</Project>
